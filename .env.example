# Runtime
NODE_ENV=production
PORT=10000
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl={"rejectUnauthorized":true}
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=owner-master-openid-12345
MASTER_ADMIN_EMAIL=admin@example.com
# Gere com: MASTER_ADMIN_PASSWORD='uma-senha-forte' pnpm auth:hash
MASTER_ADMIN_PASSWORD_HASH=

# External S3-compatible storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tst-brasil-hub
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Optional independent OpenAI-compatible features
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_MAPS_API_KEY=

# Optional generic external data API / scheduler
EXTERNAL_DATA_API_URL=
EXTERNAL_DATA_API_KEY=
EXTERNAL_SCHEDULER_URL=
EXTERNAL_SCHEDULER_API_KEY=

# Optional OAuth compatibility; leave empty to keep local authentication only
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Optional transactional email for password reset / notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL="TST Brasil Hub <noreply@example.com>"
